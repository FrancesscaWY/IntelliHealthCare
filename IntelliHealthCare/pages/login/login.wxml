<view class="login-page">
  <view class="safe-space" style="height: {{statusBarHeight}}px;"></view>

  <view class="login-nav">
    <view class="back-btn" bindtap="handleBack">
      <view class="back-arrow"></view>
    </view>
  </view>

  <view class="brand-block">
    <view class="brand-logo">
      <view class="brand-heart left"></view>
      <view class="brand-heart right"></view>
      <view class="brand-plus horizontal"></view>
      <view class="brand-plus vertical"></view>
    </view>
    <view class="brand-name">{{brandName}}</view>
  </view>

  <view class="login-heading">
    <view class="login-title">登录</view>
    <view class="login-subtitle">
      {{loginMode === 'password' ? '请输入手机号及密码登录' : '请输入手机号及验证码登录'}}
    </view>
  </view>

  <view class="form-area">
    <view class="input-box">
      <view class="input-icon phone-icon">
        <view class="phone-shell"></view>
        <view class="phone-dot"></view>
      </view>
      <view class="input-divider"></view>
      <input
        class="login-input"
        type="number"
        maxlength="11"
        placeholder="手机号"
        placeholder-class="input-placeholder"
        value="{{phone}}"
        data-field="phone"
        bindinput="handleInput"
      />
    </view>

    <view wx:if="{{loginMode === 'password'}}" class="input-box">
      <view class="input-icon lock-icon">
        <view class="lock-body"></view>
        <view class="lock-ring"></view>
      </view>
      <view class="input-divider"></view>
      <input
        class="login-input"
        password
        placeholder="密码"
        placeholder-class="input-placeholder"
        value="{{password}}"
        data-field="password"
        bindinput="handleInput"
      />
    </view>

    <view wx:else class="input-box">
      <view class="input-icon code-icon">
        <view class="code-box"></view>
        <view class="code-dot"></view>
      </view>
      <view class="input-divider"></view>
      <input
        class="login-input code-input"
        type="number"
        maxlength="6"
        placeholder="验证码"
        placeholder-class="input-placeholder"
        value="{{code}}"
        data-field="code"
        bindinput="handleInput"
      />
      <view class="code-action" bindtap="handleGetCode">获取验证码</view>
    </view>

    <view wx:if="{{loginMode === 'password'}}" class="forget-row">
      <view class="forget-btn" bindtap="handleForgetPassword">忘记密码</view>
    </view>

    <button class="login-btn" bindtap="handleLogin">登录</button>

    <view class="mode-switch" bindtap="toggleLoginMode">
      {{loginMode === 'password' ? '手机验证码登录' : '手机号密码登录'}}
    </view>
  </view>

  <view class="third-party-area">
    <view class="third-party-title">或通过以下方式登录</view>

    <view class="third-party-list">
      <block wx:for="{{thirdPartyOptions}}" wx:key="key">
        <view
          class="third-party-item"
          data-label="{{item.label}}"
          bindtap="handleThirdPartyLogin"
        >
          <view class="third-party-circle {{item.key}}">
            <text class="third-party-short">{{item.short}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="agreement-row" bindtap="toggleAgreement">
    <view class="agreement-box {{agreed ? 'agreement-box-active' : ''}}">
      <view wx:if="{{agreed}}" class="agreement-tick"></view>
    </view>
    <view class="agreement-text">
      我已阅读并同意
      <text class="policy-link" catchtap="handlePolicyTap">《隐私政策》</text>
    </view>
  </view>
</view>
