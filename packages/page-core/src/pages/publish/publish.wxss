.publish-page {
  min-height: 100vh;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.safe-space {
  flex-shrink: 0;
}

.publish-nav {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.close-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.close-line {
  position: absolute;
  left: 8rpx;
  top: 26rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #2b2b2b;
}

.line-one {
  transform: rotate(45deg);
}

.line-two {
  transform: rotate(-45deg);
}

.publish-btn {
  width: 116rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6e79f2 0%, #6570f0 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.image-row {
  margin-top: 72rpx;
  display: flex;
  flex-wrap: wrap;
}

.image-card {
  position: relative;
  width: 212rpx;
  height: 176rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.mock-cover {
  background: linear-gradient(180deg, #a8dcff 0%, #dff4ff 70%, #f3f5ff 100%);
}

.branch {
  position: absolute;
  height: 4rpx;
  background: rgba(87, 83, 79, 0.78);
  transform-origin: left center;
}

.branch-one {
  left: 16rpx;
  top: 42rpx;
  width: 184rpx;
  transform: rotate(12deg);
}

.branch-two {
  left: 104rpx;
  top: 22rpx;
  width: 88rpx;
  transform: rotate(55deg);
}

.branch-three {
  left: 74rpx;
  top: 74rpx;
  width: 96rpx;
  transform: rotate(-8deg);
}

.blossom {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.26);
}

.blossom-one {
  left: 116rpx;
  top: 26rpx;
}

.blossom-two {
  left: 146rpx;
  top: 46rpx;
}

.blossom-three {
  left: 164rpx;
  top: 22rpx;
}

.blossom-four {
  left: 58rpx;
  top: 32rpx;
}

.chosen-image {
  background: #f3f3f3;
}

.upload-card {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f4f4;
}

.upload-icon {
  position: relative;
  width: 66rpx;
  height: 56rpx;
}

.upload-frame {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 42rpx;
  height: 30rpx;
  border: 4rpx solid #a6a6a6;
  border-radius: 4rpx;
}

.upload-sun {
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a6a6a6;
}

.upload-mountain {
  position: absolute;
  left: 10rpx;
  top: 26rpx;
  width: 18rpx;
  height: 12rpx;
  border-left: 4rpx solid #a6a6a6;
  border-bottom: 4rpx solid #a6a6a6;
  transform: skew(-24deg);
}

.upload-plus {
  position: absolute;
  right: 0;
  bottom: 0;
  border-radius: 999rpx;
  background: #a6a6a6;
}

.horizontal {
  width: 22rpx;
  height: 4rpx;
  right: 0;
  bottom: 10rpx;
}

.vertical {
  width: 4rpx;
  height: 22rpx;
  right: 9rpx;
  bottom: 1rpx;
}

.editor-area {
  margin-top: 42rpx;
}

.title-input {
  height: 72rpx;
  font-size: 30rpx;
  color: #2b2b2b;
}

.title-placeholder,
.content-placeholder {
  color: #dddddd;
}

.editor-divider {
  height: 2rpx;
  background: #eeeeee;
}

.content-input {
  width: 100%;
  height: 820rpx;
  padding-top: 28rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #2b2b2b;
}
