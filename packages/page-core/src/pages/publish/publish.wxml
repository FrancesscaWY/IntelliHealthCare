<view class="publish-page">
  <view class="safe-space" style="height: {{statusBarHeight}}px;"></view>

  <view class="publish-nav">
    <view class="close-btn" bindtap="handleClose">
      <view class="close-line line-one"></view>
      <view class="close-line line-two"></view>
    </view>
    <button class="publish-btn" bindtap="handlePublish">发布</button>
  </view>

  <view class="image-row">
    <view class="image-card mock-cover">
      <view class="branch branch-one"></view>
      <view class="branch branch-two"></view>
      <view class="branch branch-three"></view>
      <view class="blossom blossom-one"></view>
      <view class="blossom blossom-two"></view>
      <view class="blossom blossom-three"></view>
      <view class="blossom blossom-four"></view>
    </view>

    <block wx:for="{{images}}" wx:key="*this">
      <image class="image-card chosen-image" src="{{item}}" mode="aspectFill"></image>
    </block>

    <view wx:if="{{images.length < 5}}" class="image-card upload-card" bindtap="handleChooseImage">
      <view class="upload-icon">
        <view class="upload-frame"></view>
        <view class="upload-sun"></view>
        <view class="upload-mountain"></view>
        <view class="upload-plus horizontal"></view>
        <view class="upload-plus vertical"></view>
      </view>
    </view>
  </view>

  <view class="editor-area">
    <input
      class="title-input"
      placeholder="输入标题"
      placeholder-class="title-placeholder"
      value="{{title}}"
      data-field="title"
      bindinput="handleInput"
    />

    <view class="editor-divider"></view>

    <textarea
      class="content-input"
      placeholder="输入内容"
      placeholder-class="content-placeholder"
      value="{{content}}"
      data-field="content"
      bindinput="handleInput"
      maxlength="-1"
    ></textarea>
  </view>
</view>
