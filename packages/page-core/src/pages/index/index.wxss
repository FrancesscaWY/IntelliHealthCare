.intro-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(180deg, #cfe6ff 0%, #eef3fb 38%, #f8f8fb 100%);
}

.safe-space {
  flex-shrink: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 36rpx 0;
}

.topbar-placeholder {
  width: 88rpx;
  height: 56rpx;
}

.skip-btn {
  padding: 12rpx 0 12rpx 24rpx;
  font-size: 32rpx;
  color: #2b4166;
}

.intro-swiper {
  flex: 1;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.hero-area {
  position: relative;
  height: 760rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-halo {
  position: absolute;
  top: 100rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.scene {
  position: relative;
  width: 560rpx;
  height: 480rpx;
  z-index: 1;
}

.hero-base-line {
  position: absolute;
  bottom: 108rpx;
  width: 540rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #6670f0;
}

.text-area {
  padding: 10rpx 72rpx 0;
  text-align: center;
}

.slide-title {
  font-size: 58rpx;
  line-height: 1.3;
  color: #6271ff;
  font-weight: 500;
}

.slide-desc {
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: #bec5d3;
}

.footer {
  padding: 20rpx 44rpx calc(44rpx + env(safe-area-inset-bottom));
}

.experience-btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #6972ef 0%, #6670f0 100%);
  color: #ffffff;
  font-size: 40rpx;
  box-shadow: 0 18rpx 40rpx rgba(102, 112, 240, 0.18);
}

.experience-btn-hover {
  opacity: 0.92;
}

.dots {
  margin-top: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d1d1d4;
  transition: all 0.2s ease;
}

.dot + .dot {
  margin-left: 18rpx;
}

.dot-active {
  background: #6670f0;
  transform: scale(1.05);
}

.doc-pill,
.doc-plus,
.archive-card,
.doctor-figure,
.helper,
.care-heart,
.care-arm,
.chart-axis,
.chart-line,
.chart-bars,
.data-person,
.data-card,
.data-dot,
.exam-doctor {
  position: absolute;
}

.doc-pill {
  width: 28rpx;
  height: 74rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #e6e6ff 0%, #e6e6ff 50%, #5c63ea 50%, #5c63ea 100%);
}

.pill-left {
  top: 150rpx;
  left: 70rpx;
}

.pill-mid {
  top: 122rpx;
  left: 112rpx;
}

.doc-plus {
  top: 350rpx;
  left: 72rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(188, 193, 251, 0.85);
}

.doc-plus-h,
.doc-plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.doc-plus-h {
  width: 20rpx;
  height: 4rpx;
  border-radius: 99rpx;
}

.doc-plus-v {
  width: 4rpx;
  height: 20rpx;
  border-radius: 99rpx;
}

.archive-card {
  top: 86rpx;
  left: 180rpx;
  width: 332rpx;
  height: 380rpx;
  padding: 42rpx 32rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(190, 195, 247, 0.82);
  border: 4rpx solid #5360df;
  box-shadow: 10rpx 10rpx 0 #323ea9;
}

.archive-card-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #f1f3ff;
}

.head-lines {
  flex: 1;
  margin-left: 18rpx;
}

.archive-lines {
  margin-top: 34rpx;
}

.line {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  margin-bottom: 26rpx;
}

.short {
  width: 70%;
}

.tiny {
  width: 42%;
}

.doctor-figure {
  left: 152rpx;
  bottom: 12rpx;
  width: 170rpx;
  height: 194rpx;
}

.doctor-head {
  position: absolute;
  left: 36rpx;
  top: 0;
  width: 88rpx;
  height: 94rpx;
  border-radius: 46rpx 46rpx 38rpx 38rpx;
  background: #ffcfca;
}

.doctor-body {
  position: absolute;
  top: 66rpx;
  left: 16rpx;
  width: 128rpx;
  height: 124rpx;
  border-radius: 34rpx 34rpx 12rpx 12rpx;
  background: #ffffff;
}

.doctor-pad {
  position: absolute;
  left: 0;
  bottom: 8rpx;
  width: 54rpx;
  height: 102rpx;
  border-radius: 8rpx;
  background: #6670f0;
  transform: rotate(-14deg);
}

.helper {
  width: 160rpx;
  height: 320rpx;
}

.helper-left {
  left: 106rpx;
  top: 72rpx;
}

.helper-right {
  right: 108rpx;
  top: 98rpx;
}

.helper-head {
  position: absolute;
  left: 40rpx;
  top: 0;
  width: 76rpx;
  height: 86rpx;
  border-radius: 44rpx;
  background: #ffb0b7;
}

.helper-body {
  position: absolute;
  left: 18rpx;
  top: 68rpx;
  width: 124rpx;
  height: 198rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.helper-apron {
  position: absolute;
  left: 46rpx;
  top: 94rpx;
  width: 72rpx;
  height: 176rpx;
  border-radius: 8rpx;
  background: #6771ef;
}

.care-heart {
  top: 234rpx;
  left: 246rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  background: #2e348d;
  transform: rotate(-28deg);
}

.care-arm {
  top: 222rpx;
  width: 124rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ffe1db;
}

.left-arm {
  left: 182rpx;
  transform: rotate(22deg);
}

.right-arm {
  left: 246rpx;
  top: 248rpx;
  transform: rotate(-22deg);
}

.chart-axis {
  background: #4e5376;
}

.axis-x {
  left: 74rpx;
  bottom: 98rpx;
  width: 412rpx;
  height: 4rpx;
}

.axis-y {
  left: 108rpx;
  bottom: 100rpx;
  width: 4rpx;
  height: 216rpx;
}

.chart-line {
  left: 118rpx;
  bottom: 150rpx;
  width: 232rpx;
  height: 4rpx;
  background: #4e5376;
  transform: rotate(-40deg);
  transform-origin: left center;
}

.chart-bars {
  left: 102rpx;
  top: 88rpx;
  display: flex;
  align-items: flex-end;
}

.chart-bars .bar + .bar {
  margin-left: 18rpx;
}

.bar {
  width: 20rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #6670f0;
}

.bar-sm {
  height: 48rpx;
}

.bar-md {
  height: 86rpx;
}

.bar-lg {
  height: 128rpx;
}

.data-person {
  left: 232rpx;
  top: 88rpx;
  width: 130rpx;
  height: 296rpx;
}

.data-head {
  position: absolute;
  left: 22rpx;
  top: 0;
  width: 86rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ffb0b7;
}

.data-top {
  position: absolute;
  top: 78rpx;
  left: 8rpx;
  width: 116rpx;
  height: 132rpx;
  border-radius: 32rpx 32rpx 20rpx 20rpx;
  background: #ffffff;
}

.data-bottom {
  position: absolute;
  left: 30rpx;
  bottom: 0;
  width: 74rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: #2c348d;
}

.data-card {
  right: 92rpx;
  bottom: 66rpx;
  width: 154rpx;
  height: 136rpx;
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid #60647f;
  display: flex;
  align-items: flex-end;
}

.data-card .mini-bar + .mini-bar {
  margin-left: 14rpx;
}

.mini-bar {
  width: 18rpx;
  height: 38rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #6670f0;
}

.mid {
  height: 56rpx;
}

.tall {
  height: 78rpx;
}

.data-dot {
  top: 148rpx;
  right: 94rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #ff6488;
}

.exam-doctor {
  width: 176rpx;
  height: 340rpx;
  top: 78rpx;
}

.exam-doctor.left {
  left: 126rpx;
}

.exam-doctor.right {
  right: 118rpx;
}

.exam-head {
  position: absolute;
  left: 44rpx;
  top: 0;
  width: 86rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ffb0b7;
}

.exam-coat {
  position: absolute;
  top: 72rpx;
  left: 22rpx;
  width: 134rpx;
  height: 208rpx;
  border-radius: 20rpx 20rpx 10rpx 10rpx;
  background: #ffffff;
}

.exam-leg {
  position: absolute;
  bottom: 0;
  width: 30rpx;
  height: 110rpx;
  border-radius: 10rpx;
  background: #28328f;
}

.left-leg {
  left: 54rpx;
}

.right-leg {
  right: 52rpx;
}

.exam-board {
  position: absolute;
  left: 0;
  top: 136rpx;
  width: 72rpx;
  height: 114rpx;
  border-radius: 8rpx;
  background: #6670f0;
  transform: rotate(-14deg);
}
