NODE_ENV=development
HOST=0.0.0.0
PORT=8190
APP_NAME="IntelliHealthCare Backend"
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://ihc:ihc123456@localhost:5432/ihc_backend?schema=public
DATABASE_DEV_FALLBACK_ENABLED=true
DATABASE_DEV_FALLBACK_AUTO_SEED=true
DATABASE_DEV_FALLBACK_HOST=127.0.0.1
DATABASE_DEV_FALLBACK_DIR=.local/embedded-postgres
DATABASE_DEV_FALLBACK_MAX_CONNECTIONS=20
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_SECRET=replace-with-another-32-characters
JWT_REFRESH_TTL=30d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ihc-files

AGENT_RAG_COLLECTION=ihc-rag
AGENT_LLM_PROVIDER=openrouter
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek/deepseek-v3.2
AGENT_LLM_LIGHT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
AGENT_LLM_FALLBACK_MODEL=qwen/qwen3-30b-a3b-instruct-2507
AGENT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AGENT_EMBEDDING_FALLBACK_MODEL=baai/bge-m3
AGENT_LLM_TIMEOUT_MS=20000
AGENT_EMBEDDING_TIMEOUT_MS=15000
AGENT_LLM_MAX_CONTEXT_TOKENS=131072
AGENT_TASK_BUDGET_USD=0.05
AGENT_STRICT_JSON_OUTPUT=true
AGENT_REQUIRE_TOOL_CALLING=true
AGENT_OPENROUTER_ALLOW_FALLBACKS=true
AGENT_OPENROUTER_ZDR=true
AGENT_MAX_RETRIES=2
AGENT_MAX_TOOL_STEPS=4
AGENT_ENABLE_TRACING=true
AGENT_WORKER_CONCURRENCY=3
