{
  "name": "intelli-health-care",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:user": "node ./scripts/dev-user.mjs --app user",
    "dev:page": "node ./scripts/dev-page.mjs --app user",
    "dev:admin": "node ./scripts/dev-user.mjs --app admin",
    "dev:admin:page": "node ./scripts/dev-page.mjs --app admin",
    "dev:backend": "npm run dev --workspace @ihc/backend",
    "build:user": "node ./scripts/build-user-web.mjs --app user",
    "build:admin": "node ./scripts/build-user-web.mjs --app admin",
    "build:backend": "npm run build --workspace @ihc/backend",
    "build": "npm run build:user && npm run build:admin && npm run build:backend",
    "check:user": "node ./scripts/validate-workspace.mjs --app user && npm run typecheck --workspace @ihc/user-web",
    "check:admin": "node ./scripts/validate-workspace.mjs --app admin && npm run typecheck --workspace @ihc/admin-web",
    "check:backend": "npm run typecheck --workspace @ihc/backend && npm run typecheck:test --workspace @ihc/backend",
    "test:backend": "npm run test --workspace @ihc/backend",
    "test:backend:unit": "npm run test:unit --workspace @ihc/backend",
    "test:backend:integration": "npm run test:integration --workspace @ihc/backend",
    "test:backend:smoke:baseline": "node ./scripts/backend-smoke-baseline.mjs",
    "test:backend:smoke:expanded": "node ./scripts/backend-smoke-expanded.mjs",
    "test:backend:smoke:regression": "node ./scripts/backend-smoke-expanded.mjs",
    "check": "npm run check:user && npm run check:admin && npm run check:backend",
    "db:generate:backend": "npm run prisma:generate --workspace @ihc/backend",
    "db:migrate:backend": "npm run prisma:migrate:dev --workspace @ihc/backend",
    "db:seed:backend": "npm run prisma:seed --workspace @ihc/backend",
    "db:build-rag:backend": "npm run rag:build --workspace @ihc/backend",
    "db:rebuild-rag:backend": "npm run rag:rebuild --workspace @ihc/backend",
    "db:eval-rag:backend": "npm run rag:eval --workspace @ihc/backend",
    "create:page": "node ./scripts/create-page.mjs --app user",
    "create:admin-page": "node ./scripts/create-page.mjs --app admin",
    "prompt:page": "node ./scripts/codex-prompt.mjs --app user",
    "prompt:admin-page": "node ./scripts/codex-prompt.mjs --app admin"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2"
  }
}
