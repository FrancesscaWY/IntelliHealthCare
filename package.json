{
  "name": "intelli-health-care",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/*"
  ],
  "scripts": {
    "dev:user": "node ./scripts/dev-user.mjs",
    "dev:page": "node ./scripts/dev-page.mjs",
    "build": "node ./scripts/build-user-web.mjs",
    "check": "node ./scripts/validate-workspace.mjs && npm run typecheck --workspace @ihc/user-web",
    "create:page": "node ./scripts/create-page.mjs",
    "prompt:page": "node ./scripts/codex-prompt.mjs"
  },
  "dependencies": {}
}
