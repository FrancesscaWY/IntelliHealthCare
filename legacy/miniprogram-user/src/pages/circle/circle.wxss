.circle-page {
  position: relative;
  height: 100vh;
  background: linear-gradient(180deg, #d7e8fb 0%, #ecf4fb 36%, #f8fafc 100%);
}

.circle-scroll {
  height: 100%;
}

.safe-space {
  flex-shrink: 0;
}

.topbar,
.banner-swiper,
.banner-dots,
.section-header,
.activity-scroll,
.feed-tabs,
.post-list {
  margin-left: 34rpx;
  margin-right: 34rpx;
}

.topbar {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 64rpx;
  color: #1d2437;
  font-weight: 600;
}

.headphone-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.head-band {
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 32rpx;
  height: 24rpx;
  border: 4rpx solid #2b2f37;
  border-bottom: 0;
  border-radius: 24rpx 24rpx 0 0;
}

.ear {
  position: absolute;
  top: 24rpx;
  width: 10rpx;
  height: 20rpx;
  border: 4rpx solid #2b2f37;
  border-radius: 10rpx;
}

.ear.left {
  left: 8rpx;
}

.ear.right {
  right: 8rpx;
}

.banner-swiper {
  height: 330rpx;
  margin-top: 34rpx;
}

.banner-card {
  position: relative;
  height: 100%;
  border-radius: 34rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  box-shadow: 0 18rpx 34rpx rgba(122, 138, 182, 0.14);
}

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14, 52, 85, 0.16) 0%, rgba(15, 35, 55, 0.32) 100%);
}

.photo {
  background-image: linear-gradient(135deg, rgba(34, 112, 160, 0.6), rgba(14, 46, 83, 0.15)), linear-gradient(180deg, #8fc3ea 0%, #6ea0c1 40%, #376f8d 100%);
}

.lecture {
  background-image: linear-gradient(135deg, rgba(255, 183, 124, 0.28), rgba(97, 120, 210, 0.24)), linear-gradient(180deg, #c3ddff 0%, #8ab7ff 100%);
}

.dance {
  background-image: linear-gradient(135deg, rgba(255, 150, 150, 0.34), rgba(95, 111, 227, 0.2)), linear-gradient(180deg, #f7c4d8 0%, #8cb6ff 100%);
}

.travel {
  background-image: linear-gradient(135deg, rgba(255, 227, 145, 0.3), rgba(113, 158, 241, 0.2)), linear-gradient(180deg, #b8dcff 0%, #8bc7d4 100%);
}

.banner-subtitle,
.banner-title-top,
.banner-center,
.banner-title-bottom {
  position: relative;
  z-index: 1;
  color: #ffffff;
}

.banner-subtitle {
  padding-top: 38rpx;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.banner-title-top,
.banner-title-bottom {
  text-align: center;
  font-size: 82rpx;
  letter-spacing: 16rpx;
}

.banner-title-top {
  margin-top: 10rpx;
}

.banner-title-bottom {
  margin-top: 92rpx;
}

.banner-center {
  margin-top: 22rpx;
  text-align: center;
  font-size: 30rpx;
}

.banner-dot {
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  margin: 0 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff82a5 0%, #ffd064 100%);
  vertical-align: middle;
}

.banner-dots {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.banner-dot-item {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.banner-dot-item + .banner-dot-item {
  margin-left: 18rpx;
}

.banner-dot-active {
  background: #6a74f0;
}

.section-header {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 56rpx;
  color: #1d2437;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  color: #b2b9c5;
  font-size: 30rpx;
}

.more-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-top: 4rpx solid #c4cad5;
  border-right: 4rpx solid #c4cad5;
  transform: rotate(45deg);
}

.activity-scroll {
  margin-top: 34rpx;
  white-space: nowrap;
}

.activity-list {
  display: inline-flex;
  padding-right: 34rpx;
}

.activity-card {
  width: 250rpx;
  margin-right: 20rpx;
}

.activity-cover {
  height: 238rpx;
  border-radius: 24rpx;
  background-size: cover;
  background-position: center;
  box-shadow: 0 12rpx 26rpx rgba(165, 180, 209, 0.14);
}

.act-one {
  background-image: linear-gradient(180deg, rgba(168, 214, 255, 0.18), rgba(249, 231, 198, 0.16)), linear-gradient(180deg, #a5d7ff 0%, #d4ecff 42%, #f4e5d0 100%);
}

.act-two {
  background-image: linear-gradient(180deg, rgba(250, 205, 209, 0.16), rgba(248, 240, 195, 0.2)), linear-gradient(180deg, #b0d9ff 0%, #d8efff 42%, #ffe2d0 100%);
}

.act-three {
  background-image: linear-gradient(180deg, rgba(188, 215, 255, 0.16), rgba(242, 231, 206, 0.18)), linear-gradient(180deg, #93cbff 0%, #d1efff 42%, #fae2cf 100%);
}

.activity-title {
  margin-top: 22rpx;
  font-size: 40rpx;
  color: #1d2437;
  font-weight: 600;
}

.activity-count {
  margin-top: 10rpx;
  font-size: 32rpx;
  color: #c0c6d1;
}

.feed-tabs {
  margin-top: 58rpx;
  display: flex;
  align-items: center;
}

.feed-tab {
  position: relative;
  margin-right: 72rpx;
  padding-bottom: 12rpx;
  font-size: 50rpx;
  color: #c9ced7;
  font-weight: 500;
}

.feed-tab-active {
  color: #1d2437;
  font-weight: 600;
}

.feed-tab-active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 26rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #22273a;
  transform: translateX(-50%);
}

.post-list {
  margin-top: 22rpx;
}

.post-card {
  margin-top: 28rpx;
  padding: 10rpx 0 26rpx;
}

.post-card:first-child {
  margin-top: 0;
}

.post-header {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 62rpx;
  height: 62rpx;
  padding: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.post-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd4c8 0%, #8ca1ff 100%);
}

.post-meta {
  display: flex;
  align-items: center;
  margin-left: 18rpx;
}

.post-author {
  font-size: 36rpx;
  color: #1f2538;
  font-weight: 600;
}

.post-date {
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #c0c6d2;
}

.post-content {
  margin-top: 24rpx;
  font-size: 38rpx;
  line-height: 1.95;
  color: #1f2538;
}

.post-images {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.post-image {
  height: 180rpx;
  border-radius: 22rpx;
  background-size: cover;
  background-position: center;
  box-shadow: 0 12rpx 24rpx rgba(171, 184, 211, 0.14);
}

.post-images-3 .post-image {
  width: 204rpx;
  margin-right: 14rpx;
}

.post-images-3 .post-image:nth-child(3n) {
  margin-right: 0;
}

.post-images-2 .post-image {
  width: 310rpx;
}

.post-images-2 .post-image + .post-image {
  margin-left: 16rpx;
}

.post-one {
  background-image: linear-gradient(135deg, #ffd4df 0%, #f8f3d1 100%);
}

.post-two {
  background-image: linear-gradient(135deg, #91d4ff 0%, #62a6ff 100%);
}

.post-three {
  background-image: linear-gradient(135deg, #ffe3b2 0%, #ff9c85 100%);
}

.post-four {
  background-image: linear-gradient(135deg, #aee3be 0%, #53c59c 100%);
}

.post-five {
  background-image: linear-gradient(135deg, #b8c7ff 0%, #6e83f0 100%);
}

.post-six {
  background-image: linear-gradient(135deg, #ffd4b5 0%, #ff9684 100%);
}

.post-seven {
  background-image: linear-gradient(135deg, #a3ecff 0%, #66bbff 100%);
}

.post-eight {
  background-image: linear-gradient(135deg, #efe3ba 0%, #b4d4ac 100%);
}

.post-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
}

.post-action {
  display: flex;
  align-items: center;
  margin-right: 46rpx;
  font-size: 28rpx;
  color: #676d78;
}

.post-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.heart-icon::before,
.bubble-icon::before,
.share-icon::before,
.share-icon::after {
  content: "";
  position: absolute;
}

.heart-icon::before {
  left: 5rpx;
  top: 7rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #5e6470;
  border-bottom: 4rpx solid #5e6470;
  border-radius: 0 0 0 18rpx;
  transform: rotate(45deg);
}

.bubble-icon::before {
  left: 2rpx;
  top: 4rpx;
  width: 24rpx;
  height: 18rpx;
  border: 4rpx solid #5e6470;
  border-radius: 16rpx;
}

.bubble-icon::after {
  content: "";
  position: absolute;
  left: 10rpx;
  bottom: 2rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 4rpx solid #5e6470;
  border-bottom: 4rpx solid #5e6470;
  transform: rotate(-35deg);
}

.share-icon::before {
  left: 4rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #5e6470;
  border-top: 4rpx solid #5e6470;
}

.share-icon::after {
  right: 2rpx;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #5e6470;
  border-right: 4rpx solid #5e6470;
}

.bottom-space {
  height: 180rpx;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(118rpx + env(safe-area-inset-bottom));
  padding: 12rpx 26rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 24rpx rgba(177, 186, 209, 0.12);
}

.tab-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.tab-item-center {
  transform: translateY(-22rpx);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-text {
  font-size: 34rpx;
  color: #343943;
}

.tab-icon-active .tab-icon-text {
  color: #6670f0;
}

.tab-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #343943;
}

.tab-label-active {
  color: #6670f0;
}

.tab-icon-publish {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6670f0 0%, #f07a82 100%);
  box-shadow: 0 16rpx 28rpx rgba(120, 110, 220, 0.22);
}

.tab-icon-publish .tab-icon-text {
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1;
}
