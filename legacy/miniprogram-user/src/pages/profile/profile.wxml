<view class="profile-page">
  <scroll-view class="profile-scroll" scroll-y enable-flex>
    <view class="safe-space" style="height: {{statusBarHeight}}px;"></view>

    <view class="hero-card">
      <view class="hero-topbar">
        <view class="hero-title">Profile</view>
        <view class="hero-more" data-label="More" bindtap="handlePendingAction">...</view>
      </view>

      <view class="profile-main">
        <view class="avatar-wrap">
          <view class="avatar-core"></view>
        </view>

        <view class="profile-meta">
          <view class="profile-name">{{profile.name}}</view>
          <view class="profile-region">{{profile.region}}</view>
          <view class="profile-motto">{{profile.motto}}</view>
        </view>
      </view>

      <view class="stat-row">
        <block wx:for="{{profile.stats}}" wx:key="key">
          <view class="stat-item">
            <view class="stat-value">{{item.value}}</view>
            <view class="stat-label">{{item.label}}</view>
          </view>
        </block>
      </view>

      <view class="hero-actions">
        <view class="ghost-button" data-label="Message" bindtap="handlePendingAction">Message</view>
        <view class="follow-button" data-label="Follow" bindtap="handlePendingAction">+ Follow</view>
      </view>
    </view>

    <view class="feed-panel">
      <view class="feed-heading">Posts {{feedCount}}</view>

      <block wx:for="{{posts}}" wx:key="id">
        <view class="post-card">
          <view class="post-header">
            <view class="post-avatar"></view>
            <view class="post-meta-block">
              <view class="post-author">{{item.author}}</view>
              <view class="post-date">{{item.date}}</view>
            </view>
          </view>

          <view wx:if="{{item.title}}" class="post-title">{{item.title}}</view>
          <view class="post-content">{{item.content}}</view>

          <view wx:if="{{item.images.length}}" class="post-images">
            <block wx:for="{{item.images}}" wx:key="*this">
              <image class="post-image" src="{{item}}" mode="aspectFill"></image>
            </block>
          </view>

          <view class="post-actions">
            <view class="post-action" data-label="Like" bindtap="handlePendingAction">
              <text>Like</text>
              <text>{{item.likes}}</text>
            </view>
            <view class="post-action" data-label="Comment" bindtap="handlePendingAction">
              <text>Comment</text>
              <text>{{item.comments}}</text>
            </view>
            <view class="post-action" data-label="Share" bindtap="handlePendingAction">
              <text>Share</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="tabbar">
    <block wx:for="{{tabItems}}" wx:key="key">
      <view
        class="tab-item {{item.key === 'publish' ? 'tab-item-center' : ''}}"
        data-key="{{item.key}}"
        data-label="{{item.label}}"
        bindtap="handleTabTap"
      >
        <view
          class="tab-icon {{activeTab === item.key ? 'tab-icon-active' : ''}} {{item.key === 'publish' ? 'tab-icon-publish' : ''}}"
        >
          <text class="tab-icon-text">{{item.iconText}}</text>
        </view>
        <view wx:if="{{item.label}}" class="tab-label {{activeTab === item.key ? 'tab-label-active' : ''}}">
          {{item.label}}
        </view>
      </view>
    </block>
  </view>
</view>
