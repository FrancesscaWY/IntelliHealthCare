.home-page {
  position: relative;
  height: 100vh;
  background: linear-gradient(180deg, #d7e9ff 0%, #edf4fb 38%, #f7f9fc 100%);
}

.home-scroll {
  height: 100%;
}

.safe-space {
  flex-shrink: 0;
}

.topbar,
.search-area,
.service-grid,
.feature-panel,
.reminder-card,
.section-header,
.disease-list,
.article-list {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.topbar {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ip-block {
  display: flex;
  align-items: center;
}

.ip-icon {
  position: relative;
  width: 28rpx;
  height: 36rpx;
  border: 4rpx solid #1d2438;
  border-radius: 20rpx 20rpx 20rpx 0;
  transform: rotate(-45deg);
}

.ip-dot {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1d2438;
}

.ip-text {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #1f253a;
  font-weight: 600;
}

.scan-btn {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(10rpx);
}

.scan-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-color: #1f253a;
  border-style: solid;
}

.corner-top-left {
  left: 16rpx;
  top: 16rpx;
  border-width: 4rpx 0 0 4rpx;
}

.corner-top-right {
  right: 16rpx;
  top: 16rpx;
  border-width: 4rpx 4rpx 0 0;
}

.corner-bottom-left {
  left: 16rpx;
  bottom: 16rpx;
  border-width: 0 0 4rpx 4rpx;
}

.corner-bottom-right {
  right: 16rpx;
  bottom: 16rpx;
  border-width: 0 4rpx 4rpx 0;
}

.search-area {
  margin-top: 28rpx;
}

.search-box {
  height: 78rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6570ef 0%, #ff7a70 100%);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 100%;
  margin-left: 18rpx;
  color: #ffffff;
  font-size: 32rpx;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.88);
}

.tag-list {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #8e97ab;
  font-size: 28rpx;
}

.service-grid {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
}

.service-card {
  width: 214rpx;
  padding: 24rpx 12rpx 26rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 32rpx rgba(173, 186, 216, 0.12);
  text-align: center;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(180deg, #ecefff 0%, #e7e8fb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-icon-text {
  font-size: 42rpx;
  color: #ea787f;
  font-weight: 600;
}

.service-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #16233d;
  font-weight: 600;
}

.service-desc {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #9da5b5;
}

.feature-panel {
  margin-top: 26rpx;
  padding: 26rpx 18rpx 8rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 30rpx rgba(171, 184, 211, 0.1);
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
}

.feature-item {
  width: 25%;
  margin-bottom: 34rpx;
  text-align: center;
}

.feature-icon {
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.mint {
  background: linear-gradient(180deg, #79dbc7 0%, #61c7ba 100%);
}

.violet {
  background: linear-gradient(180deg, #99a2ff 0%, #7681f4 100%);
}

.amber {
  background: linear-gradient(180deg, #ffdb85 0%, #f0b95d 100%);
}

.coral {
  background: linear-gradient(180deg, #ff9597 0%, #f47175 100%);
}

.teal {
  background: linear-gradient(180deg, #72e0c9 0%, #49c6ad 100%);
}

.lavender {
  background: linear-gradient(180deg, #a7b0ff 0%, #7b85eb 100%);
}

.gold {
  background: linear-gradient(180deg, #ffd97d 0%, #edc05a 100%);
}

.sky {
  background: linear-gradient(180deg, #8caeff 0%, #6386eb 100%);
}

.peach {
  background: linear-gradient(180deg, #ffaea6 0%, #ff8c87 100%);
}

.green {
  background: linear-gradient(180deg, #76e1b9 0%, #49c89a 100%);
}

.indigo {
  background: linear-gradient(180deg, #8c96ff 0%, #6670f0 100%);
}

.feature-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  color: #182640;
}

.reminder-card {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 28rpx rgba(171, 184, 211, 0.1);
}

.reminder-side {
  width: 120rpx;
  font-size: 48rpx;
  line-height: 1.1;
  color: #3dd8a7;
  font-weight: 600;
}

.reminder-divider {
  width: 2rpx;
  height: 86rpx;
  margin: 0 24rpx;
  background: #d6dce7;
}

.reminder-content {
  flex: 1;
}

.reminder-title {
  font-size: 36rpx;
  color: #222a3d;
  font-weight: 600;
}

.reminder-desc {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #9fa7b7;
}

.section-header {
  margin-top: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 54rpx;
  color: #1f2539;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #afb5c0;
}

.more-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  border-top: 4rpx solid #c3c9d4;
  border-right: 4rpx solid #c3c9d4;
  transform: rotate(45deg);
}

.disease-list {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
}

.disease-chip {
  min-width: 140rpx;
  padding: 20rpx 28rpx;
  margin-right: 18rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #21293f;
  font-size: 32rpx;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(186, 196, 219, 0.08);
}

.article-list {
  margin-top: 18rpx;
}

.article-card {
  margin-top: 26rpx;
  padding: 34rpx 34rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 30rpx rgba(177, 188, 214, 0.1);
}

.article-card:first-child {
  margin-top: 0;
}

.article-title {
  font-size: 44rpx;
  color: #20263b;
  font-weight: 600;
}

.article-desc {
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #9ca5b5;
}

.article-images {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
}

.article-image {
  width: 196rpx;
  height: 180rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: flex-end;
  padding: 18rpx;
  box-sizing: border-box;
}

.article-image-label {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.img-one {
  background: linear-gradient(135deg, #f6fdcb 0%, #ff7d7d 100%);
}

.img-two {
  background: linear-gradient(135deg, #83c9ff 0%, #5d9bff 100%);
}

.img-three {
  background: linear-gradient(135deg, #fff1b4 0%, #ffa08c 100%);
}

.img-four {
  background: linear-gradient(135deg, #a0d0ff 0%, #4e8fff 100%);
}

.img-five {
  background: linear-gradient(135deg, #9ee8c5 0%, #45c997 100%);
}

.img-six {
  background: linear-gradient(135deg, #ffe9a6 0%, #ffaf7b 100%);
}

.article-actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.article-action {
  display: flex;
  align-items: center;
  color: #22273b;
  font-size: 30rpx;
}

.action-with-text text {
  margin-left: 12rpx;
}

.action-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.share-icon::before,
.share-icon::after,
.like-icon::before,
.star-icon::before,
.comment-icon::before {
  content: "";
  position: absolute;
}

.share-icon::before {
  left: 4rpx;
  top: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #2b2f39;
  border-top: 4rpx solid #2b2f39;
}

.share-icon::after {
  right: 0;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #2b2f39;
  border-right: 4rpx solid #2b2f39;
}

.like-icon::before {
  left: 2rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #2b2f39;
  border-bottom: 4rpx solid #2b2f39;
  border-radius: 0 0 0 18rpx;
  transform: rotate(45deg);
}

.star-icon::before {
  left: 6rpx;
  top: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #2b2f39;
  transform: rotate(45deg);
}

.comment-icon::before {
  left: 2rpx;
  top: 4rpx;
  width: 24rpx;
  height: 18rpx;
  border: 4rpx solid #2b2f39;
  border-radius: 16rpx;
}

.comment-icon::after {
  content: "";
  position: absolute;
  left: 8rpx;
  bottom: 0;
  width: 10rpx;
  height: 10rpx;
  border-left: 4rpx solid #2b2f39;
  border-bottom: 4rpx solid #2b2f39;
  transform: rotate(-35deg);
}

.bottom-space {
  height: 190rpx;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(118rpx + env(safe-area-inset-bottom));
  padding: 12rpx 26rpx calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 24rpx rgba(177, 186, 209, 0.12);
}

.tab-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.tab-item-center {
  transform: translateY(-22rpx);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-text {
  font-size: 34rpx;
  color: #343943;
}

.tab-icon-active .tab-icon-text {
  color: #6670f0;
}

.tab-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #343943;
}

.tab-label-active {
  color: #6670f0;
}

.tab-icon-publish {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6670f0 0%, #f07a82 100%);
  box-shadow: 0 16rpx 28rpx rgba(120, 110, 220, 0.22);
}

.tab-icon-publish .tab-icon-text {
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1;
}
