.login-page {
  min-height: 100vh;
  padding: 0 52rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #cfe6ff 0%, #eef3fb 44%, #f9f9fb 100%);
}

.safe-space {
  flex-shrink: 0;
}

.login-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #36415c;
  border-bottom: 4rpx solid #36415c;
  transform: rotate(45deg);
}

.brand-block {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #7280ff 0%, #f07b82 100%);
  box-shadow: 0 18rpx 36rpx rgba(108, 117, 235, 0.16);
}

.brand-heart {
  position: absolute;
  top: 28rpx;
  width: 22rpx;
  height: 32rpx;
  background: #ffffff;
}

.brand-heart.left {
  left: 24rpx;
  border-radius: 22rpx 22rpx 0 22rpx;
  transform: rotate(-45deg);
}

.brand-heart.right {
  right: 24rpx;
  border-radius: 22rpx 22rpx 22rpx 0;
  transform: rotate(45deg);
}

.brand-plus {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(255, 255, 255, 0.88);
  transform: translate(-50%, -50%);
  border-radius: 999rpx;
}

.horizontal {
  width: 26rpx;
  height: 6rpx;
}

.vertical {
  width: 6rpx;
  height: 26rpx;
}

.brand-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1c243c;
}

.login-heading {
  margin-top: 108rpx;
}

.login-title {
  font-size: 76rpx;
  line-height: 1.15;
  color: #22273e;
  font-weight: 500;
}

.login-subtitle {
  margin-top: 14rpx;
  font-size: 32rpx;
  color: #c1c7d3;
}

.form-area {
  margin-top: 72rpx;
}

.input-box {
  height: 98rpx;
  margin-top: 30rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 34rpx rgba(176, 188, 214, 0.08);
}

.input-box:first-child {
  margin-top: 0;
}

.input-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.phone-shell {
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 24rpx;
  height: 34rpx;
  border: 4rpx solid #c8c8c8;
  border-radius: 10rpx;
}

.phone-dot {
  position: absolute;
  left: 18rpx;
  bottom: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #c8c8c8;
}

.lock-body {
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #c8c8c8;
  border-radius: 6rpx;
}

.lock-ring {
  position: absolute;
  left: 12rpx;
  top: 2rpx;
  width: 18rpx;
  height: 20rpx;
  border: 4rpx solid #c8c8c8;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.code-box {
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 34rpx;
  height: 26rpx;
  border: 4rpx solid #c8c8c8;
  border-radius: 8rpx;
}

.code-dot {
  position: absolute;
  left: 14rpx;
  top: 18rpx;
  width: 14rpx;
  height: 4rpx;
  background: #c8c8c8;
  border-radius: 999rpx;
}

.input-divider {
  width: 2rpx;
  height: 34rpx;
  margin: 0 20rpx 0 22rpx;
  background: #ececec;
}

.login-input {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  color: #262c42;
}

.input-placeholder {
  color: #d0d0d0;
}

.code-input {
  flex: none;
  width: 220rpx;
}

.code-action {
  margin-left: auto;
  font-size: 28rpx;
  color: #6670f0;
}

.forget-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.forget-btn {
  font-size: 30rpx;
  color: #9fa5b3;
}

.login-btn {
  margin-top: 36rpx;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #6c76f0 0%, #6570f0 100%);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 600;
  box-shadow: 0 18rpx 36rpx rgba(102, 112, 240, 0.2);
}

.mode-switch {
  margin-top: 42rpx;
  text-align: center;
  font-size: 36rpx;
  color: #6670f0;
}

.third-party-area {
  margin-top: 150rpx;
}

.third-party-title {
  text-align: center;
  font-size: 30rpx;
  color: #d3d3d7;
}

.third-party-list {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.third-party-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.third-party-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(176, 188, 214, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.third-party-short {
  font-size: 36rpx;
  font-weight: 600;
  color: #292929;
}

.wechat .third-party-short,
.weibo .third-party-short {
  font-size: 30rpx;
}

.taobao .third-party-short {
  font-weight: 700;
}

.agreement-row {
  margin-top: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-box {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cfd4df;
  background: #ffffff;
}

.agreement-box-active {
  border-color: #6872f0;
  background: #6872f0;
}

.agreement-tick {
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(40deg);
}

.agreement-text {
  margin-left: 18rpx;
  font-size: 30rpx;
  color: #d0d4dc;
}

.policy-link {
  color: #22273e;
}
