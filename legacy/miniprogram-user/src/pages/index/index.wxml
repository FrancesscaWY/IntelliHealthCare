<view class="intro-page">
  <view class="safe-space" style="height: {{statusBarHeight}}px;"></view>

  <view class="topbar">
    <view class="topbar-placeholder"></view>
    <text class="skip-btn" bindtap="handleSkip">跳过</text>
  </view>

  <swiper
    class="intro-swiper"
    current="{{current}}"
    bindchange="handleSwiperChange"
    duration="320"
  >
    <block wx:for="{{slides}}" wx:key="key">
      <swiper-item>
        <view class="slide">
          <view class="hero-area">
            <view class="hero-halo"></view>

            <view wx:if="{{item.key === 'archive'}}" class="scene scene-archive">
              <view class="doc-pill pill-left"></view>
              <view class="doc-pill pill-mid"></view>
              <view class="doc-plus">
                <view class="doc-plus-h"></view>
                <view class="doc-plus-v"></view>
              </view>
              <view class="archive-card">
                <view class="archive-card-head">
                  <view class="avatar"></view>
                  <view class="head-lines">
                    <view class="line short"></view>
                    <view class="line tiny"></view>
                  </view>
                </view>
                <view class="archive-lines">
                  <view class="line"></view>
                  <view class="line short"></view>
                  <view class="line"></view>
                  <view class="line short"></view>
                  <view class="line"></view>
                </view>
              </view>
              <view class="doctor-figure">
                <view class="doctor-head"></view>
                <view class="doctor-body"></view>
                <view class="doctor-pad"></view>
              </view>
            </view>

            <view wx:if="{{item.key === 'nursing'}}" class="scene scene-nursing">
              <view class="helper helper-left">
                <view class="helper-head"></view>
                <view class="helper-body"></view>
                <view class="helper-apron"></view>
              </view>
              <view class="helper helper-right">
                <view class="helper-head"></view>
                <view class="helper-body"></view>
                <view class="helper-apron"></view>
              </view>
              <view class="care-heart"></view>
              <view class="care-arm left-arm"></view>
              <view class="care-arm right-arm"></view>
            </view>

            <view wx:if="{{item.key === 'data'}}" class="scene scene-data">
              <view class="chart-axis axis-x"></view>
              <view class="chart-axis axis-y"></view>
              <view class="chart-line"></view>
              <view class="chart-bars">
                <view class="bar bar-sm"></view>
                <view class="bar bar-md"></view>
                <view class="bar bar-lg"></view>
              </view>
              <view class="data-person">
                <view class="data-head"></view>
                <view class="data-top"></view>
                <view class="data-bottom"></view>
              </view>
              <view class="data-card">
                <view class="mini-bar"></view>
                <view class="mini-bar tall"></view>
                <view class="mini-bar mid"></view>
              </view>
              <view class="data-dot"></view>
            </view>

            <view wx:if="{{item.key === 'exam'}}" class="scene scene-exam">
              <view class="exam-doctor left">
                <view class="exam-head"></view>
                <view class="exam-coat"></view>
                <view class="exam-leg left-leg"></view>
                <view class="exam-leg right-leg"></view>
                <view class="exam-board"></view>
              </view>
              <view class="exam-doctor right">
                <view class="exam-head"></view>
                <view class="exam-coat"></view>
                <view class="exam-leg left-leg"></view>
                <view class="exam-leg right-leg"></view>
              </view>
            </view>

            <view class="hero-base-line"></view>
          </view>

          <view class="text-area">
            <view class="slide-title">{{item.title}}</view>
            <view class="slide-desc">{{item.desc}}</view>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <view class="footer">
    <button class="experience-btn" hover-class="experience-btn-hover" bindtap="handleExperience">
      立即体验
    </button>

    <view class="dots">
      <block wx:for="{{slides}}" wx:key="key">
        <view class="dot {{index === current ? 'dot-active' : ''}}"></view>
      </block>
    </view>
  </view>
</view>
